<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

  <!-- 로그 파일 위치 및 공통 패턴 정의 -->
  <property name="LOG_HOME" value="logs"/>
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%-5level] [%X{traceId},%X{spanId}] %logger{15} - %msg%n"/>

  <!-- 텍스트 콘솔 appender (dev/default용) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight([%-5level] [%X{traceId},%X{spanId}]) %cyan(%logger{15}) - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- prod 전용: JSON 콘솔 appender (Loki/Promtail이 stdout에서 수집) -->
  <springProfile name="prod">
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeMdc>true</includeMdc>
        <includeContext>false</includeContext>
        <includeCallerData>false</includeCallerData>
        <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
        <timeZone>UTC</timeZone>
        <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        <fieldNames>
          <timestamp>timestamp</timestamp>
          <version>[ignore]</version>
        </fieldNames>
        <customFields>{"service":"hvy-blog"}</customFields>
        <!-- 스택트레이스 축약: Docker 로그 드라이버가 16KB 초과 라인을 분할해 JSON이 깨지고 뒤쪽 필드(traceId)가 유실되므로
             한 줄이 항상 16KB 미만이 되도록 상한을 둔다. 전체 스택은 tb_system_log 에 별도 보존된다. -->
        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
          <maxDepthPerThrowable>30</maxDepthPerThrowable>
          <maxLength>8192</maxLength>
          <shortenedClassNameLength>36</shortenedClassNameLength>
          <rootCauseFirst>true</rootCauseFirst>
          <exclude>^jdk\.internal\.reflect\..*</exclude>
          <exclude>^java\.lang\.reflect\..*</exclude>
          <exclude>.*\$\$SpringCGLIB\$\$.*</exclude>
          <exclude>^org\.springframework\.aop\..*</exclude>
          <exclude>^org\.springframework\.security\.web\..*</exclude>
          <exclude>^org\.springframework\.web\.filter\..*</exclude>
          <exclude>^org\.springframework\.session\.web\..*</exclude>
          <exclude>^org\.apache\.catalina\..*</exclude>
          <exclude>^org\.apache\.coyote\..*</exclude>
          <exclude>^org\.apache\.tomcat\..*</exclude>
          <exclude>^jakarta\.servlet\..*</exclude>
          <truncateAfter>^org\.springframework\.web\.servlet\.DispatcherServlet\..*</truncateAfter>
        </throwableConverter>
      </encoder>
    </appender>
  </springProfile>

  <!-- 비-default 프로필: 파일 롤링 appender -->
  <springProfile name="!default">
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_HOME}/application.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <fileNamePattern>${LOG_HOME}/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxHistory>7</maxHistory>
        <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
          <maxFileSize>10MB</maxFileSize>
        </timeBasedFileNamingAndTriggeringPolicy>
      </rollingPolicy>
      <encoder>
        <pattern>${LOG_PATTERN}</pattern>
      </encoder>
    </appender>
  </springProfile>

  <!-- Root 로거: 프로필별 분기 -->
  <springProfile name="default">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="JSON_CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="!default &amp; !prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </root>
  </springProfile>

</configuration>
